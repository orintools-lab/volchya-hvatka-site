generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  MAIN
  ADDITIONAL
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  CDEK
}

enum DeliveryType {
  PICKUP
  COURIER
}

enum ShashkaSize {
  ADULT
  TEEN
  CHILD
  BY_HEIGHT
}

enum ContentKind {
  TEXT
  RICH_TEXT
  IMAGE
  VIDEO
  JSON
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  sessions     Session[]
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  category    ProductCategory
  name        String
  subtitle    String?
  description String
  price       Decimal         @db.Decimal(12, 2)
  oldPrice    Decimal?        @db.Decimal(12, 2)
  composition String[]
  benefits    String[]
  imageUrl    String?
  badge       String?
  buttonLabel String          @default("Купить комплект")
  weightGrams Int             @default(1000)
  lengthCm    Int             @default(30)
  widthCm     Int             @default(20)
  heightCm    Int             @default(10)
  packageCount Int            @default(1)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  OrderItem[]

  @@index([category, isActive, sortOrder])
}

model Review {
  id             String   @id @default(cuid())
  authorName     String
  city           String?
  text           String
  rating         Int
  imageUrl       String?
  reviewDate     DateTime?
  showOnHomepage Boolean  @default(false)
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isVisible, showOnHomepage, sortOrder])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, sortOrder])
}

model ContentBlock {
  id        String      @id @default(cuid())
  key       String      @unique
  section   String
  label     String
  kind      ContentKind @default(TEXT)
  value     Json
  sortOrder Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([section, isVisible, sortOrder])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     Json
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  originalName String
  fileName     String   @unique
  mimeType     String
  size         Int
  path         String
  alt          String?
  createdAt    DateTime @default(now())
}

model Order {
  id             String          @id @default(cuid())
  number         String          @unique
  status         OrderStatus     @default(NEW)
  customerName   String
  phone          String
  email          String
  city           String
  postalCode     String?
  deliveryMethod DeliveryMethod
  deliveryType   DeliveryType
  deliveryAddress String?
  cdekCityCode   Int
  cdekPointCode  String?
  cdekPointName  String?
  cdekPointAddress String?
  cdekTariffCode Int
  cdekTariffName String
  deliveryMinDays Int?
  deliveryMaxDays Int?
  deliveryQuoteId String
  deliveryQuotedAt DateTime
  cdekOrderUuid  String?
  cdekNumber     String?
  shashkaSize    ShashkaSize
  customerHeight Int?
  customerComment String?
  adminNote      String?
  subtotal       Decimal         @db.Decimal(12, 2)
  deliveryPrice  Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  utm            Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          OrderItem[]
  payments       Payment[]

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  productSlug String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  total       Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?
  invoiceId         Int           @unique
  idempotencyKey    String        @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  payload           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([orderId, status])
  @@unique([provider, providerPaymentId])
}

model Session {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  externalEventId String?
  eventType       String
  payload         Json?
  processedAt     DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, processedAt])
  @@unique([paymentId, externalEventId])
}

model DeliveryQuote {
  id              String       @id @default(cuid())
  productId       String
  quantity        Int
  cityCode        Int
  cityName        String
  deliveryType    DeliveryType
  pointCode       String?
  pointName       String?
  pointAddress    String?
  address         String?
  tariffCode      Int
  tariffName      String
  price           Decimal      @db.Decimal(12, 2)
  minDays         Int?
  maxDays         Int?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  @@index([expiresAt])
  @@index([productId])
}

model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime   @default(now())
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([adminId, createdAt])
}

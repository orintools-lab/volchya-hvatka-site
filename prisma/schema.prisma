generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  MAIN
  ADDITIONAL
}

enum OrderStatus {
  NEW
  AWAITING_DELIVERY_AGREEMENT
  AWAITING_SIZE_AGREEMENT
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  NOT_CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum UpsellOfferStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
}

enum DeliveryProvider {
  CDEK
  OZON
  MANUAL

  @@map("DeliveryMethod")
}

enum DeliveryAgreementStatus {
  NOT_REQUIRED
  PENDING
  AGREED
}

enum DeliveryType {
  PICKUP
  COURIER
}

enum ShashkaSize {
  ADULT
  TEEN
  CHILD
  BY_HEIGHT
}

enum ContentKind {
  TEXT
  RICH_TEXT
  IMAGE
  VIDEO
  JSON
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  sessions     Session[]
}

model Product {
  id           String          @id @default(cuid())
  slug         String          @unique
  category     ProductCategory
  name         String
  subtitle     String?
  description  String
  price        Decimal         @db.Decimal(12, 2)
  oldPrice     Decimal?        @db.Decimal(12, 2)
  composition  String[]
  benefits     String[]
  imageUrl     String?
  badge        String?
  buttonLabel  String          @default("Купить комплект")
  weightGrams  Int             @default(1000)
  lengthCm     Int             @default(30)
  widthCm      Int             @default(20)
  heightCm     Int             @default(10)
  packageCount Int             @default(1)
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orderItems   OrderItem[]

  @@index([category, isActive, sortOrder])
}

model Review {
  id             String    @id @default(cuid())
  authorName     String
  city           String?
  text           String
  rating         Int
  imageUrl       String?
  reviewDate     DateTime?
  showOnHomepage Boolean   @default(false)
  isVisible      Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isVisible, showOnHomepage, sortOrder])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, sortOrder])
}

model ContentBlock {
  id        String      @id @default(cuid())
  key       String      @unique
  section   String
  label     String
  kind      ContentKind @default(TEXT)
  value     Json
  sortOrder Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([section, isVisible, sortOrder])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     Json
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  originalName String
  fileName     String   @unique
  mimeType     String
  size         Int
  path         String
  alt          String?
  createdAt    DateTime @default(now())
}

model Order {
  id                      String                  @id @default(cuid())
  number                  String                  @unique
  status                  OrderStatus             @default(NEW)
  customerName            String
  phone                   String
  email                   String
  city                    String?
  postalCode              String?
  deliveryProvider        DeliveryProvider        @map("deliveryMethod")
  deliveryType            DeliveryType?
  deliveryAddress         String?
  cdekCityCode            Int?
  cdekPointCode           String?
  cdekPointName           String?
  cdekPointAddress        String?
  cdekTariffCode          Int?
  cdekTariffName          String?
  deliveryMinDays         Int?
  deliveryMaxDays         Int?
  deliveryQuoteId         String?
  deliveryQuotedAt        DateTime?
  cdekOrderUuid           String?
  cdekNumber              String?
  shashkaSize             ShashkaSize
  customerHeight          Int?
  recommendedLengthCm     Int?
  actualLengthCm          Int?
  secondActualLengthCm    Int?
  shashkaCount            Int                     @default(2)
  material                String                  @default("Берёзовая фанера")
  deliveryAgreementStatus DeliveryAgreementStatus @default(NOT_REQUIRED)
  agreedDeliveryPrice     Decimal?                @db.Decimal(12, 2)
  deliveryComment         String?
  deliveryAgreedAt        DateTime?
  customerComment         String?
  adminNote               String?
  subtotal                Decimal                 @db.Decimal(12, 2)
  deliveryPrice           Decimal?                @db.Decimal(12, 2)
  total                   Decimal?                @db.Decimal(12, 2)
  utm                     Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  items                   OrderItem[]
  payments                Payment[]
  upsellOffer             UpsellOffer?

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String?
  productName          String
  productSlug          String
  unitPrice            Decimal  @db.Decimal(12, 2)
  quantity             Int
  total                Decimal  @db.Decimal(12, 2)
  recommendedLengthCm  Int?
  actualLengthCm       Int?
  secondActualLengthCm Int?
  shashkaCount         Int      @default(2)
  material             String   @default("Берёзовая фанера")
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String?
  upsellOfferId     String?        @unique
  provider          String
  providerPaymentId String?
  invoiceId         Int            @unique
  idempotencyKey    String         @unique
  status            PaymentStatus  @default(PENDING)
  amount            Decimal        @db.Decimal(12, 2)
  payload           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  upsellOffer       UpsellOffer?   @relation(fields: [upsellOfferId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
}

model UpsellOffer {
  id           String            @id @default(cuid())
  orderId      String            @unique
  expiresAt    DateTime
  usedAt       DateTime?
  status       UpsellOfferStatus @default(ACTIVE)
  regularPrice Decimal           @db.Decimal(12, 2)
  specialPrice Decimal           @db.Decimal(12, 2)
  viewCount    Int               @default(0)
  clickCount   Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment      Payment?

  @@index([status, expiresAt])
}

model UpsellSettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  regularPrice    Decimal  @default(3390) @db.Decimal(12, 2)
  specialPrice    Decimal  @default(2000) @db.Decimal(12, 2)
  durationMinutes Int      @default(5)
  videoUrl        String?
  title           String   @default("Специальное предложение только для новых учеников")
  text            String   @default("Пока вы находитесь на этой странице, вы можете получить полный курс «Мастер»")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  externalEventId String?
  eventType       String
  payload         Json?
  processedAt     DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, externalEventId])
  @@index([paymentId, processedAt])
}

model DeliveryQuote {
  id           String           @id @default(cuid())
  productId    String
  quantity     Int
  provider     DeliveryProvider @default(CDEK)
  cityCode     Int
  cityName     String
  deliveryType DeliveryType
  pointCode    String?
  pointName    String?
  pointAddress String?
  address      String?
  tariffCode   Int
  tariffName   String
  price        Decimal          @db.Decimal(12, 2)
  minDays      Int?
  maxDays      Int?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())

  @@index([expiresAt])
  @@index([productId])
}

model DeliveryProviderConfig {
  provider    DeliveryProvider @id
  isEnabled   Boolean          @default(false)
  label       String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model LengthRule {
  id          String   @id @default(cuid())
  minHeightCm Int
  maxHeightCm Int?
  lengthCm    Int
  label       String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, minHeightCm, maxHeightCm])
}

model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime   @default(now())
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([adminId, createdAt])
}
